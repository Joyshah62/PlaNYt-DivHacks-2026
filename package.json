{
  "name": "roam-nyc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "start:imessage": "tsx scripts/imessage.mts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "crowd-data": "node scripts/build-crowd-data.mjs",
    "poi-data": "node scripts/build-poi-data.mjs",
    "imessage": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/imessage.mts",
    "db:check": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-check.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@spectrum-ts/imessage": "^12.10.1",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.11.2",
    "mongodb": "^7.6.0",
    "next": "16.3.5",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "spectrum-ts": "^12.10.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0"
  }
}
