# Optional. Without it the report still works end to end - the narrative simply
# stays with the deterministic, rule-generated sentences.
ANTHROPIC_API_KEY=

# Optional. Raises NYC Open Data's anonymous rate limit.
NYC_APP_TOKEN=

# Optional building photography. Enable Street View Static API and billing in Google Cloud.
# This browser-visible key must have website/referrer restrictions for your domains
# (including localhost for development) and an API restriction to Street View Static API.
# Set before building; restart dev / rebuild after changing it. Without it, map links work.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
