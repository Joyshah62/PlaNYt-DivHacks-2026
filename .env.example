# Optional. Powers plan generation, trip chat, search intent and price extraction.
# Get a Gemini API key at https://aistudio.google.com/apikey.
# Without it, manual planning remains available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: another model to retry on when the main one stalls or is rate limited.
GEMINI_FALLBACK_MODEL=

# Optional. Google Places: ratings, prices, hours and photos for "Find something
# that fits my trip", and photos in the place card. Needs "Places API (New)"
# enabled on the key's Google Cloud project. Use a server key (IP- or API-restricted,
# not referrer-restricted): it is only ever sent from the server. Falls back to
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY if unset. Without a working key, places come from
# OpenStreetMap (no ratings) and photos from Wikipedia / Wikimedia Commons.
GOOGLE_PLACES_API_KEY=

# Hard caps so Google never bills you. Each counts calls per Google billing month
# (Pacific time) and per day; past a cap the app falls back as above.
#   SEARCH: discovery searches = "Text Search Enterprise", 1,000 free/month ($35/1,000 after)
#   PHOTOS: each photo = "Text Search Pro" (5,000 free) + "Place Details Photos"
#           (1,000 free, $7/1,000 after)
# 950 stays under the 1,000 free. Also set quotas in Google Cloud: that is the real backstop.
GOOGLE_SEARCH_MONTHLY_CAP=950
GOOGLE_SEARCH_DAILY_CAP=100
GOOGLE_PHOTOS_MONTHLY_CAP=950
GOOGLE_PHOTOS_DAILY_CAP=500

# iMessage bot (npm run imessage). Project id and secret from the Photon dashboard
# (https://app.photon.codes), under Settings.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# "Text to my phone": the web app POSTs plans to the bot's bridge.
# Production: https://imessage.planyt.tech (CNAME → roam-imessage on Render).
# Local only: http://127.0.0.1:4100
PHONE_BRIDGE_URL=https://imessage.planyt.tech
PHONE_BRIDGE_TOKEN=
# Optional local port when PORT is unset (Render sets PORT for you).
# PHONE_BRIDGE_PORT=4100
# Bind address for the bridge. Local default 127.0.0.1; Render: 0.0.0.0
# PHONE_BRIDGE_HOST=127.0.0.1
# Where the bot reaches the web app, and the base for map links in texts.
ROAM_URL=https://planyt.tech
PUBLIC_APP_URL=https://planyt.tech

# Optional: web search for the trip chat ("is MoMA free on Fridays?", "what's on at the Met?").
# From https://app.tavily.com. Each search is 1 credit; the cap bounds a day's use.
TAVILY_API_KEY=
TAVILY_DAILY_CAP=200

# Optional: memory across chats and trips ("we're vegetarian", "staying at the Ace",
# "hate crowds"), from https://app.backboard.io. Each traveler gets a Backboard
# assistant that keeps the lasting facts from what they type; Gemini still answers.
# Without it, Roam only remembers the current conversation.
BACKBOARD_API_KEY=

# ElevenLabs speech: STT (voice notes / mic) + TTS (Listen + iMessage voice replies).
# Paste your key from https://elevenlabs.io → Profile → API Key.
ELEVENLABS_API_KEY=
# Speak replies as iMessage voice notes (off by default; true = also send a voice note).
ELEVENLABS_IMESSAGE_VOICE=false
# Optional overrides:
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# MongoDB Atlas: accounts (Better Auth), saved trips, "Plan with friends", and
# iMessage thread state (when MONGODB_URI is set the bot stores chats in Mongo
# instead of a local JSON file — required on Render).
# Atlas: Database > Connect > Drivers, e.g.
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/roam-nyc?retryWrites=true&w=majority
# URL-encode special characters in the password, and allow your IP (and Render's
# egress) under Network Access. Check with `npm run db:check`.
# Unset locally → mongodb://127.0.0.1:27017 and file-based iMessage threads.
MONGODB_URI=
# The database in the cluster; defaults to the one in MONGODB_URI, else "roam-nyc".
MONGODB_DB=
# Required in production: `openssl rand -hex 32`. Signs session cookies.
BETTER_AUTH_SECRET=
# Primary site URL. Google OAuth redirect: $BETTER_AUTH_URL/api/auth/callback/google
# → https://planyt.tech/api/auth/callback/google (add that URI in Google Cloud).
BETTER_AUTH_URL=https://planyt.tech
# Extra hosts (comma-separated). www + Render preview hostnames if needed.
BETTER_AUTH_ALLOWED_HOSTS=planyt.tech,www.planyt.tech
# Optional: headers carrying the visitor's IP, in order (sign-in is rate limited per IP).
# Default: cf-connecting-ip (Render/Cloudflare), x-vercel-forwarded-for, x-forwarded-for.
BETTER_AUTH_IP_HEADERS=
NEXT_PUBLIC_APP_URL=https://planyt.tech

# Home / demo maps. NEXT_PUBLIC_* are baked in at `next build` — set on Render
# before building (or rebuild after changing). maplibre = free tiles; google = 3D.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_ENGINE=google

# Optional: "Continue with Google". Create an OAuth client (Web application) at
# https://console.cloud.google.com/apis/credentials, with redirect URI:
#   https://planyt.tech/api/auth/callback/google
# Roam asks Google for the phone number on the person's Google profile (enable the
# People API on the project). It's a sensitive scope: until Google verifies the app,
# only test users added on the OAuth consent screen can sign in. Set
# GOOGLE_REQUEST_PHONE=false to skip it; people then type their number after signing in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REQUEST_PHONE=true
